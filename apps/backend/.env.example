PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=control_asistencia

# Secreto para el token de sesión de dispositivo (Capa 1, larga duración)
JWT_DEVICE_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Secreto para el token de jornada (Capa 2, 1 por día, dura lo que
# indique horarios.duracion_jornada_horas)
JWT_JORNADA_SECRET=cambia_esto_tambien_por_otro_secreto

JWT_ADMIN_SECRET=cambia_esto_por_otro_secreto_mas

# Secreto para el token de las pantallas de TV (Capa 3, sin expiración)
JWT_TV_SECRET=cambia_esto_por_un_cuarto_secreto_distinto

# Tamaño máximo (MB) de cada archivo multimedia para TV (imagen, video o música)
MULTIMEDIA_MAX_MB=100

# Carpeta local de fotos (para producción, reemplazar por S3/bucket)
UPLOADS_DIR=./uploads/asistencia

CORS_ORIGINS=http://localhost:5173

# Verificación de rostro en la foto de entrada/salida (ver apps/backend/src/utils/rostro.js)
#   permisivo (por defecto): rechaza fotos sin rostro; si el detector falla, deja pasar y avisa en consola
#   estricto: rechaza también cuando el detector falla
#   desactivado: no revisa nada
VERIFICAR_ROSTRO=permisivo
# ROSTRO_PUNTAJE_MIN=0.5   # confianza mínima del detector
# ROSTRO_TAMANO_MIN=0.15   # tamaño mínimo del rostro (fracción del lado corto de la foto)
# HUMAN_MODELS_DIR=./models
